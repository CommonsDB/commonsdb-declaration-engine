# dependencies
node_modules
*.swp

# sst — ignore everything except the generated type augmentations, which are
# committed so `tsc` / CI can typecheck on a fresh clone without AWS credentials
# (they contain resource names/shapes only, no secret values). Regenerated by
# `sst dev` / `sst build`; commit the diff if it changes.
.sst/*
!.sst/types/
.sst/types/*
!.sst/types/index.ts
.build
.sst.config.*

# opennext
.open-next

# misc
.DS_Store
**/yarn-error.log

# local env files
.env
*.env
.env*.local

# secrets / keys
*.pem

# terraform (external infra lives in sibling repos)
*.tfstate*
.terraform

# editor
.vscode/settings.json

# local scratch / debug data (never committed)
debug/

# account-specific CDK cache
cdk.context.json
