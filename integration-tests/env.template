# CommonsDB Integration Tests Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration (required)
API_BASE_URL=https://your-api-gateway-base-url
API_KEY=your-api-key-here

# Declarer Identity (required) — the did:key of your test declarer
DECLARER_ID=did:key:your-test-declarer
# Defaults to DECLARER_ID when unset
#COMPANY_ID=

# EC Keypair Paths (relative to this folder or absolute paths)
EC_PRIVATE_KEY_PATH=./api_test_ec_private_key.pem
EC_PUBLIC_KEY_PATH=./api_test_ec_public_key.pem

# Timestamp Authority
TSA_URL=https://freetsa.org/tsr

# Test ISCC Code (any valid ISCC works)
